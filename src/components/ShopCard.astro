---
import { Picture } from 'astro:assets';
import { T, url } from '../i18n.js';
import { address, directions, phoneText } from '../data/site.js';
import Pill from './Pill.astro';

const { shop, lang, image } = Astro.props;
const t = T[lang];
---
<article class="card rise">
  <a class="photo" href={url(lang, shop.id)} tabindex="-1" aria-hidden="true">
    <Picture src={image} alt="" widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" formats={['avif', 'webp']} />
    {shop.isNew && <span class="badge display">{t.newBadge}</span>}
  </a>
  <div class="body">
    <p class="eyebrow">{shop.nick[lang]}</p>
    <h3 class="display"><a href={url(lang, shop.id)}>{shop.name}</a></h3>
    <p>{address(shop, lang)}</p>
    <Pill shop={shop} lang={lang} />
    <div class="actions">
      <a class="btn btn-solid" href={directions(shop)} target="_blank" rel="noopener">{t.directions}</a>
      <a class="btn" href={`tel:${shop.phones[0]}`}><span class="mono">{phoneText(shop.phones[0])}</span></a>
      <a class="btn" href={url(lang, shop.id)}>{t.shopPage}</a>
    </div>
  </div>
</article>

<style>
  .card { display: grid; background: var(--ink-2); border-radius: 22px; overflow: hidden; border: 1px solid var(--line-ink); }
  .photo { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .card:hover .photo :global(img) { transform: scale(1.04); } }
  .badge { position: absolute; top: 16px; left: 16px; background: var(--amber); color: var(--ink); font-size: 22px; padding: 6px 12px 4px; border-radius: 8px; transform: rotate(-4deg); }
  .body { display: grid; gap: 12px; padding: 22px clamp(18px, 3vw, 28px) 26px; justify-items: start; }
  h3 { font-size: clamp(36px, 5vw, 56px); }
  h3 a { text-decoration: none; }
  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
</style>
