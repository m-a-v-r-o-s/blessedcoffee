---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ShopSwitch from '../components/ShopSwitch.astro';
import { T } from '../i18n.js';
import { MENU, price } from '../data/site.js';
import p1 from '../../social/photos/shoot/espresso-steam.jpg';
import p2 from '../../social/photos/shoot/pastry-sesame.jpg';
import p3 from '../../social/photos/shoot/snack-plate.jpg';

const { lang } = Astro.props;
const t = T[lang];
const cols = (sec) => (Array.isArray(sec.cols) ? sec.cols : sec.cols?.[lang]);
---
<Base lang={lang} page="menu" slug="menu">
  <section class="top band">
    <div class="wrap head">
      <div>
        <p class="eyebrow">Blessed Coffee & Spirits</p>
        <h1 class="display">{t.menuTitle}</h1>
        <p class="lede">{t.menuSub}</p>
      </div>
      <div class="pick">
        <ShopSwitch lang={lang} />
        <p class="note" data-only="kamatero">{t.menuKamateroNote}</p>
      </div>
    </div>
    <div class="wrap strip" aria-hidden="true">
      {[p1, p2, p3].map((p) => <Picture src={p} alt="" widths={[400, 700]} sizes="(min-width: 900px) 33vw, 50vw" formats={['avif', 'webp']} />)}
    </div>
  </section>

  <nav class="chips" aria-label={t.jumpTo}>
    <div class="wrap">{MENU.map((s) => <a href={`#${s.id}`}>{s.title[lang]}</a>)}</div>
  </nav>

  <div class="paper band">
    <div class="wrap sections">
      {MENU.map((sec) => (
        <section id={sec.id} class="sec" aria-labelledby={`${sec.id}-h`}>
          <h2 id={`${sec.id}-h`} class="display">{sec.title[lang]}</h2>
          <table>
            {cols(sec) && (
              <thead><tr><th scope="col"><span class="sr-only">{sec.title[lang]}</span></th>{cols(sec).map((c) => <th scope="col">{c}</th>)}</tr></thead>
            )}
            <tbody>
              {sec.items.map(([name, ...prices]) => (
                <tr>
                  <th scope="row">{name}</th>
                  {prices.map((p) => <td class="mono">{price(p)}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .top { padding-bottom: 32px; }
  .head { display: grid; gap: 28px; align-items: end; }
  @media (min-width: 900px) { .head { grid-template-columns: 1fr auto; } }
  h1 { font-size: clamp(88px, 16vw, 200px); }
  .pick { display: grid; gap: 12px; justify-items: start; max-width: 380px; }
  .note { font-size: 14px; color: var(--on-ink-muted); }
  .strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 40px; }
  .strip :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); }
  @media (max-width: 600px) { .strip { grid-template-columns: 1fr 1fr; } .strip :global(picture:last-child) { display: none; } }

  .chips { position: sticky; top: calc(var(--header-h) + env(safe-area-inset-top, 0px)); z-index: 30; background: rgb(11 11 11 / 0.9); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-block: 1px solid var(--line-ink); }
  .chips .wrap { display: flex; gap: 8px; overflow-x: auto; padding-block: 10px; scrollbar-width: none; overscroll-behavior-x: contain; }
  .chips .wrap::-webkit-scrollbar { display: none; }
  .chips a { flex: none; display: inline-flex; align-items: center; min-height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--line-ink); text-decoration: none; font-weight: 600; font-size: 14px; transition: transform var(--press-ms) var(--ease-out), border-color 0.2s; }
  .chips a:active { transform: scale(var(--press-scale)); }
  @media (hover: hover) and (pointer: fine) { .chips a:hover { border-color: var(--on-ink); } }

  .sections { display: grid; gap: 56px 64px; }
  @media (min-width: 900px) { .sections { grid-template-columns: 1fr 1fr; } }
  .sec { scroll-margin-top: calc(var(--header-h) + 80px); }
  .sec h2 { font-size: clamp(44px, 6vw, 64px); margin-bottom: 12px; padding-bottom: 10px; border-bottom: 3px solid var(--on-paper); }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 11px 0; border-bottom: 1px solid var(--line-paper); vertical-align: baseline; }
  tbody th { text-align: left; font-weight: 500; padding-right: 16px; }
  thead th { font: 500 12px/1.2 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-paper-muted); text-align: right; padding-top: 0; }
  td { text-align: right; white-space: nowrap; font-weight: 500; padding-left: 16px; width: 1%; }
</style>
