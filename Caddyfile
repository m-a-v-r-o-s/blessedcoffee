# Railpack serves the Vite build with Caddy and uses this file instead of its default.
# Same as the default plus security headers and a real 404 (the site has no client-side
# routes: navigation is pushState with no URL change).
{
	admin off
	persist_config off
	auto_https off

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
		# Report-Only until watched on the live site. The sha256 is the inline font loader in
		# index.html: if that script changes, recompute it. frame-ancestors is ignored in
		# Report-Only, X-Frame-Options covers it meanwhile. style-src needs 'unsafe-inline'
		# because the React app uses inline style attributes and a <style> block.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-DUjSDIyElktbLz5tG7XZNHneifBz618EoMh2/6hfaW8='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'; frame-src https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	root * dist

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	# No SPA fallback: unknown URLs get a real 404.
	try_files {path} {path}.html {path}/index.html
}
